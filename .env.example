# Conexão PostgreSQL (Supabase: Project Settings → Database → Connection string → "Session pooler" ou "Direct")
DATABASE_URL=postgresql://postgres:SENHA@db.xxxxx.supabase.co:5432/postgres
# Segredo para assinar sessões. Gere com: openssl rand -base64 48
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Defina "true" quando o banco exigir SSL (Supabase exige)
DATABASE_SSL=true
# Use "true" com o pooler do Supabase (as configurações de fuso ficam no papel do banco)
DATABASE_NO_STARTUP_OPTIONS=false
